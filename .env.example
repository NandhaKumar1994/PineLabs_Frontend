# Copy this file to .env for local development.

# Base URL of the PineLabs_Backend FastAPI server (include /api/v1).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional: HTTP request timeout in milliseconds (default 30000).
VITE_API_TIMEOUT=30000

# --- LOCAL DEV AUTH ONLY ---------------------------------------------
# Fallback bearer token used only if no one has signed in yet (see
# src/pages/Login.jsx). Must be an existing, Active row in the backend's
# `users` table, and the backend must have DEV_AUTH_ENABLED=true. This is
# NOT real authentication — see PineLabs_Backend/app/core/auth.py.
VITE_DEV_AUTH_EMAIL=admin@pinelabs.com
